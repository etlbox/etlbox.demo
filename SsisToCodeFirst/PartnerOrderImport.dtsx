          SQLTask:Connection="{C1D2E3F4-A5B6-4789-8C9D-0E1F2A3B4C5D}"
          SQLTask:SqlStatementSource="SELECT COUNT(*) AS StagingCount FROM dbo.StagingOrders; SELECT COUNT(*) AS OrderCount FROM dbo.Orders;" />
      </DTS:ObjectData>
